---
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'SASE Student Chapter',
	description = 'A professional student organization focused on leadership, service, culture, and career development.',
} = Astro.props;

const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/programs', label: 'Programs' },
	{ href: '/conferences', label: 'Conferences' },
	{ href: '/events', label: 'Events' },
	{ href: '/sponsorship', label: 'Sponsorship' },
	{ href: '/get-involved', label: 'Get Involved' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="nav-shell" aria-label="Primary navigation">
				<a class="brand" href="/">
					<span>SASE</span>
					<small>Student Chapter</small>
				</a>
				<div class="nav-links">
					{
						navItems.map((item) => {
							const itemPath = item.href === '/' ? '/' : item.href;
							const isActive = pathname === itemPath;

							return (
								<a href={item.href} aria-current={isActive ? 'page' : undefined}>
									{item.label}
								</a>
							);
						})
					}
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #f7f8f3;
		--color-surface: #ffffff;
		--color-text: #17212f;
		--color-muted: #5d6978;
		--color-primary: #1f4d7a;
		--color-primary-dark: #143453;
		--color-accent: #9a6a20;
		--color-soft-blue: #e7eff7;
		--color-soft-green: #e8efe7;
		--color-border: #d9dfdf;
		--shadow-soft: 0 18px 45px rgba(23, 33, 47, 0.08);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		color: var(--color-text);
		background: var(--color-bg);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-width: 320px;
		min-height: 100%;
	}

	body {
		background: var(--color-bg);
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}

	main {
		min-height: 70vh;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(217, 223, 223, 0.82);
		background: rgba(247, 248, 243, 0.94);
		backdrop-filter: blur(14px);
	}

	.nav-shell {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
		min-height: 76px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.brand {
		display: inline-grid;
		gap: 1px;
		text-decoration: none;
		color: var(--color-primary-dark);
	}

	.brand span {
		font-weight: 800;
		font-size: 1.18rem;
		letter-spacing: 0;
	}

	.brand small {
		color: var(--color-muted);
		font-size: 0.78rem;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 6px;
	}

	.nav-links a {
		padding: 9px 10px;
		border-radius: 8px;
		color: var(--color-muted);
		font-size: 0.93rem;
		font-weight: 650;
		text-decoration: none;
		transition:
			background 180ms ease,
			color 180ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible,
	.nav-links a[aria-current='page'] {
		color: var(--color-primary-dark);
		background: var(--color-soft-blue);
	}

	.page-section {
		width: min(1240px, calc(100% - 32px));
		margin: 0 auto;
		padding: 56px 0;
	}

	.page-section.compact {
		padding-top: 28px;
	}

	.hero {
		width: min(1240px, calc(100% - 32px));
		margin: 0 auto;
		padding: 36px 0 34px;
		display: grid;
		grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
		align-items: center;
		gap: 28px;
	}

	.hero > *,
	.grid > *,
	.photo-strip > * {
		min-width: 0;
	}

	.hero.media-first {
		grid-template-columns: 1fr;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		color: var(--color-text);
		line-height: 1.08;
		letter-spacing: 0;
	}

	h1 {
		max-width: 720px;
		font-size: clamp(2.1rem, 5.4vw, 4rem);
	}

	h2 {
		font-size: clamp(1.45rem, 3vw, 2.45rem);
	}

	h3 {
		font-size: 1.08rem;
	}

	p {
		color: var(--color-muted);
		line-height: 1.55;
	}

	.lead {
		max-width: 520px;
		margin: 14px 0 0;
		font-size: 0.98rem;
	}

	.section-heading {
		max-width: 620px;
		margin-bottom: 22px;
	}

	.grid {
		display: grid;
		gap: 22px;
	}

	.grid.two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.grid.three {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.grid.four {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.panel {
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-surface);
		box-shadow: var(--shadow-soft);
	}

	.content-panel {
		padding: 22px;
	}

	.kicker {
		margin: 0 0 9px;
		color: var(--color-accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.button-row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 22px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0 18px;
		border: 1px solid var(--color-primary);
		border-radius: 8px;
		background: var(--color-primary);
		color: #ffffff;
		font-weight: 760;
		text-decoration: none;
		transition:
			background 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.button.secondary {
		background: transparent;
		color: var(--color-primary);
	}

	.button:hover,
	.button:focus-visible {
		border-color: var(--color-primary-dark);
		background: var(--color-primary-dark);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.media-card {
		position: relative;
		overflow: hidden;
		border-radius: 8px;
		color: #ffffff;
		background: var(--color-primary-dark);
		text-decoration: none;
		min-width: 0;
	}

	.media-card :global(.image-placeholder) {
		border: 0;
		border-radius: 8px;
	}

	.media-caption {
		position: absolute;
		right: 16px;
		bottom: 16px;
		left: 16px;
		z-index: 4;
		display: grid;
		gap: 6px;
		padding: 16px;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 8px;
		background: rgba(20, 52, 83, 0.76);
		backdrop-filter: blur(12px);
	}

	.media-caption h1,
	.media-caption h2,
	.media-caption h3,
	.media-caption p,
	.media-caption span {
		color: #ffffff;
	}

	.media-caption p {
		max-width: 560px;
		margin: 0;
		font-size: 0.94rem;
	}

	.photo-strip {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
		gap: 18px;
	}

	@media (max-width: 900px) {
		.nav-shell {
			align-items: flex-start;
			flex-direction: column;
			padding: 16px 0;
		}

		.nav-links {
			justify-content: flex-start;
		}

		.hero,
		.photo-strip,
		.grid.two,
		.grid.three,
		.grid.four {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 28px;
		}
	}

	@media (max-width: 620px) {
		.page-section,
		.hero {
			width: min(100% - 24px, 1240px);
		}

		.media-caption {
			position: static;
			border-color: var(--color-border);
			background: var(--color-primary-dark);
		}
	}
</style>
